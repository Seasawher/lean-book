{
  "pandoc": {
    "profile": {
      "pdf": {
        "output-file": "../../typst/book.pdf",
        "to": "typst",
        "pdf-engine": "typst",
        "filters": [],
        "metadata": {
          "title": "Lean Book",
          "author": ["Asei Inoue"]
        },
        "variables": {
          "template": "typst/book.typ",
          "papersize": "a4",
          "fontsize": "10.5pt",
          "mainfont": "Arial",
          "codefont": ["Cascadia Mono", "Noto Sans JP"],
          "margin": {
            "x": "2.5cm",
            "y": "2cm"
          }
        }
      }
    },
    "markdown": {
      "extensions": {
        "math": true
      }
    }
  }
}
